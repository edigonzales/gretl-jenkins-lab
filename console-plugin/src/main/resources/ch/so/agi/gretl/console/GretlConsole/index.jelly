<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout">
  <l:layout title="GRETL Console">
    <l:header>
      <link rel="stylesheet" href="${rootURL}/plugin/gretl-console/css/console.css"/>
    </l:header>
    <l:main-panel>
      <div class="gretl-console">
        <h1>GRETL Console</h1>
        <j:set var="jobs" value="${it.jobs}"/>
        <j:choose>
          <j:when test="${empty(jobs)}"><p>Keine GRETL-Jobs verfügbar.</p></j:when>
          <j:otherwise>
            <div class="gretl-catalog">
              <j:forEach var="job" items="${jobs}">
                <article class="gretl-card">
                  <div class="gretl-card-meta">
                    <j:choose><j:when test="${job.flow}">Ablauf</j:when><j:otherwise>Job</j:otherwise></j:choose>
                    <j:if test="${not empty(job.schedule)}"> · Zeitgesteuert</j:if>
                  </div>
                  <h2><a href="${rootURL}/gretl-console/${job.id}/">${job.title}</a></h2>
                  <p>${job.description}</p>
                  <j:set var="latest" value="${job.latest}"/>
                  <div class="gretl-card-meta">
                    <j:choose>
                      <j:when test="${job.queued}">In der Warteschlange</j:when>
                      <j:when test="${latest != null}"><a href="${rootURL}/${latest.url}">#${latest.number}</a> · ${latest.status}</j:when>
                      <j:otherwise>Noch keine Ausführung</j:otherwise>
                    </j:choose>
                  </div>
                </article>
              </j:forEach>
            </div>
          </j:otherwise>
        </j:choose>
      </div>
    </l:main-panel>
  </l:layout>
</j:jelly>
